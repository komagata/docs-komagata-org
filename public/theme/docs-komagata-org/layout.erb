<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
<% if entry? %>
    <title><%= @entry.title %> - <%= @site.title %></title>
<% else %>
    <title><%= @site.title %></title>
<% end %>
    <meta name="description" content="<%= @site.meta_description %>">
    <meta name="keywords" content="<%= @site.meta_keywords %>">
    <meta name="google-site-verification" content="bjMN32QSRWUy3_FNCPWKTSGKcqywy0mBltNBgqW-sgE">
    <link rel="shortcut icon" href="<%= @theme.path %>/favicon.ico">
    <link title="<%= @site.title %>" rel="alternate" href="/index.atom" type="application/atom+xml">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" type="text/css">
    <link rel="stylesheet" href="<%= @theme.path %>/style.css" type="text/css">
    <%= header %>
  </head>
  <body>
    <div id="nav">
      <ul>
        <li><a href="https://x.com/komagata" target="_blank"><i class="fa-brands fa-x-twitter"></i></a></li>
        <li><a href="https://github.com/komagata" target="_blank"><i class="fa-brands fa-github"></i></a></li>
        <li><a href="https://www.facebook.com/komagata1111" target="_blank"><i class="fa-brands fa-facebook"></i></a></li>
        <li>
          <form id="search" action="/search/" method="get">
            <input type="text" name="query">
            <button type="submit">Search</button>
          </form>
        </li>
      </ul>
    </div>
    <div id="wrapper">
      <a href="/" id="header" class="clearfix">
        <h1><%= @site.title %></h1>
      </a>
<% unless index? or entry? %>
      <div id="bread_crumb"><%= bread_crumb %></div>
<% end %>
      <div id="content">
        <%= yield %>
      </div>
      <div id="footer">
        <div class="poweredby">
          powered by <%= link_to 'Lokka', 'http://lokka.org/', target: '_blank' %>
        </div>
      </div>
      <%= footer %>
    </div>
  </body>
</html>
